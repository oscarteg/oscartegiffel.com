---

import { getCollection } from "astro:content";
import Body from "./Body.astro";
import BookCover from "./BookCover.astro";
import PageIntro from "./PageIntro.astro";

/**
 * The shelf, filtered by status at build time. There is no client script:
 * each filter is a link to its own pre-rendered page, so the shelf works
 * with JavaScript disabled. `all` is the /books landing; the three statuses
 * live at /books/<status>.
 */
export type BookFilter = "all" | "read" | "reading" | "to-read";

export type Props = {
	active: BookFilter;
};

const { active } = Astro.props;

const STATUS_LABELS = {
	read: "Read",
	reading: "Reading",
	"to-read": "Will read",
} as const;

const HEADINGS: Record<BookFilter, string> = {
	all: "What I'm reading",
	read: "What I've read",
	reading: "What I'm reading",
	"to-read": "What's next",
};

/* Links, not buttons: filtering is navigation. */
const filters = [
	{ value: "all", label: "All", href: "/books" },
	{ value: "read", label: "Read", href: "/books/read" },
	{ value: "reading", label: "Reading", href: "/books/reading" },
	{ value: "to-read", label: "Will read", href: "/books/to-read" },
] as const;

const books = (await getCollection("books")).sort((a, b) =>
	a.data.title.localeCompare(b.data.title),
);

const counts = {
	all: books.length,
	read: books.filter((book) => book.data.status === "read").length,
	reading: books.filter((book) => book.data.status === "reading").length,
	"to-read": books.filter((book) => book.data.status === "to-read").length,
};

/* Featured is an explicit flag in books.yaml rather than anything derived —
   the point of the file is that the shelf is hand-curated. */
const featured = books.filter((book) => book.data.featured).slice(0, 4);
const reading = books.filter((book) => book.data.status === "reading");
/* The intro names one; the FACTS row below lists the rest. */
const current = reading[0];

const shelf =
	active === "all"
		? books
		: books.filter((book) => book.data.status === active);

const stars = (rating: number) => "★".repeat(rating);
---

<Body title="Books" description="What I've read, what I'm reading, and what's next.">
  <PageIntro eyebrow="Books" title={HEADINGS[active]}>
    <p class="books__intro">
      Seeded once from a Goodreads export, hand-maintained since.
      {
        current && (
          <>
            Currently reading <strong>{current.data.title}</strong> by {current.data.author}
                      {reading.length > 1 ? `, and ${reading.length - 1} more.` : "."}
          </>
        )
      }
    </p>
  </PageIntro>

  {
    active === "all" && featured.length > 0 && (
      <section class="featured">
        <h2 class="label group__label">Featured</h2>
        <ul class="grid grid--featured">
          {featured.map((book) => (
            <li class="book">
              <BookCover cover={book.data.cover} title={book.data.title} author={book.data.author} />
              <p class="book__title">{book.data.title}</p>
              <p class="book__meta">
                {book.data.author} · {STATUS_LABELS[book.data.status]}
                {book.data.rating && <> · {stars(book.data.rating)}</>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="shelf">
    <nav class="group__label group__label--nav" aria-label="Shelf">
      {
        filters.map((filter) => (
          <a href={filter.href} class="label" aria-current={filter.value === active ? "page" : undefined}>
            {filter.label} <span class="shelf__count">{counts[filter.value]}</span>
          </a>
        ))
      }
    </nav>

    {
      shelf.length > 0 ? (
        <ul class="grid grid--shelf">
          {shelf.map((book) => (
            <li class="book">
              <BookCover cover={book.data.cover} title={book.data.title} author={book.data.author} />
              <p class="book__title">{book.data.title}</p>
              <p class="book__meta">
                {book.data.author} · {STATUS_LABELS[book.data.status]}
                {book.data.rating && <> · {stars(book.data.rating)}</>}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="shelf__empty">Nothing on this shelf yet.</p>
      )
    }
  </section>
</Body>

<style>
	.books__intro {
		font: var(--type-small);
		color: var(--text-muted);
		max-width: 52ch;
		margin: 0;
	}

	.books__intro strong {
		font-weight: var(--weight-semibold);
		color: var(--text-heading);
	}

	.group__label {
		display: flex;
		gap: 24px;
		padding-bottom: 12px;
		margin: 0 0 24px;
		border-bottom: var(--border-hairline-w) solid var(--border-strong);
	}

	.group__label--nav a {
		color: var(--text-meta);
	}

	.group__label--nav a:hover,
	.group__label--nav a[aria-current="page"] {
		color: var(--text-heading);
	}

	.shelf__count {
		color: var(--text-meta);
		margin-left: 2px;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 32px 20px;
	}

	.grid--featured {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.grid--shelf {
		grid-template-columns: repeat(6, minmax(0, 1fr));
	}

	.book {
		min-width: 0;
	}

	.book__title {
		font: var(--type-fine);
		font-weight: var(--weight-medium);
		line-height: 1.4;
		color: var(--text-heading);
		margin: 12px 0 0;
	}

	.book__meta {
		font: var(--type-fine);
		font-size: 11px;
		color: var(--text-meta);
		margin: 3px 0 0;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		margin: 64px 0 0;
		padding-top: 20px;
		border-top: var(--border-hairline-w) solid var(--border-hairline);
	}

	.facts__label {
		font: var(--type-label-sm);
		letter-spacing: var(--track-label);
		margin: 0 0 7px;
	}

	.facts__value {
		font: var(--type-small);
		font-size: 12.5px;
		color: var(--text-body);
		margin: 0;
	}

	.shelf {
		margin-top: 88px;
	}

	.featured + .shelf {
		margin-top: 96px;
	}

	.shelf__empty {
		font: var(--type-body);
		color: var(--text-muted);
	}

	@media (max-width: 1000px) {
		.grid--shelf {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.grid--featured,
		.grid--shelf {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.facts {
			grid-template-columns: 1fr;
			gap: 20px;
			margin-top: 40px;
		}

		.shelf,
		.featured + .shelf {
			margin-top: 56px;
		}
	}

	@media (max-width: 480px) {
		.grid--featured,
		.grid--shelf {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.group__label {
			flex-wrap: wrap;
			gap: 10px 18px;
		}
	}
</style>
