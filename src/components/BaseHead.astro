---

import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../config";
import { buildGraph } from "../json-ld";
import type { Post } from "../models";
import "../styles/global.css";
import JsonLd from "./JsonLd.astro";

export type Props = {
	title?: string | undefined;
	description?: string | undefined;
	post?: Post | undefined;
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	post,
} = Astro.props;

const path = Astro.url.pathname;
const pageUrl = `${SITE_URL}${path}`;

/* Every page shares a card except the ones that earned their own: each post
   and the taste bible. Rendered at build by /og/[slug].png. */
const ogSlug = post
	? post.id
	: path.replace(/\/$/, "") === "/taste"
		? "taste"
		: "home";
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site);

const jsonLdGraph = post
	? buildGraph({ type: "blog-post", post, url: pageUrl })
	: path === "/"
		? buildGraph({ type: "home" })
		: path === "/blog" || path === "/blog/"
			? buildGraph({ type: "blog-index" })
			: buildGraph({ type: "page", url: pageUrl, name: title });
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />


<!-- Paper only: form controls and scrollbars stay light. -->
<meta name="color-scheme" content="light" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!--
  The grotesk carries every page; preloading the latin subset avoids a
  flash of fallback text. Other subsets and the mono load on demand.
-->
<link
  rel="preload"
  href="/fonts/Archivo-var-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="canonical" href={canonicalURL} />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
/>
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<meta content="eZSdmzAXlLkKhNJzfgwDqWORghxnJ8qR9_CHdAh5-xw" name="google-site-verification" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />

<!-- Structured data for search engines and LLM crawlers -->
<JsonLd graph={jsonLdGraph} />
