---
/**
 * Dot + uppercase label. `live` is the green availability dot; anything
 * else (a draft, a scheduled post) takes the accent.
 */
export type Props = {
	label: string;
	tone?: "live" | "accent" | undefined;
};

const { label, tone = "accent" } = Astro.props;
---

<span class:list={["status", `status--${tone}`]}>
  <span class="status__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font: var(--type-label-sm);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.status__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}

	.status--live .status__dot {
		background: var(--live);
	}

	.status--accent {
		color: var(--accent-fg);
	}
</style>
