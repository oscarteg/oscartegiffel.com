---

import { uses } from "../config";

/**
 * Two ruled columns of categories, each a label over a rule and a list of
 * items separated by hairlines. Items with a one-liner keep it on the same
 * line; longer notes drop underneath.
 */
const isShort = (description: string) => description.length <= 60;
---

<div class="not-prose uses">
  {
    uses.map((category) => (
      <section class="category">
        <h2 class="label category__label">{category.title}</h2>
        <ul class="category__items">
          {category.items.map((item) => (
            <li class:list={["item", item.description && !isShort(item.description) && "item--stacked"]}>
              <span class="item__name">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.name} ↗
                  </a>
                ) : (
                  item.name
                )}
              </span>
              {item.description && <span class="item__note"> {item.description}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
	/* Masonry via columns: the categories are wildly uneven in length, so
	   letting them flow beats a grid full of holes. */
	.uses {
		width: 100%;
		columns: 2;
		column-gap: 64px;
	}

	.category {
		break-inside: avoid;
		margin-bottom: 52px;
	}

	.category__label {
		padding-bottom: 12px;
		margin: 0;
		border-bottom: var(--border-hairline-w) solid var(--border-strong);
	}

	.category__items {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.item {
		padding: 14px 0;
		border-bottom: var(--border-hairline-w) solid var(--border-soft);
	}

	.item:last-child {
		border-bottom: none;
	}

	.item__name {
		font: var(--type-item);
		color: var(--text-heading);
	}

	.item__name a {
		color: inherit;
	}

	.item__name a:hover {
		color: var(--text-meta);
	}

	.item__note {
		font: var(--type-small);
		font-size: 12.5px;
		color: var(--text-meta);
	}

	.item__note::before {
		content: "— ";
	}

	.item--stacked .item__note {
		display: block;
		margin-top: 5px;
	}

	.item--stacked .item__note::before {
		content: none;
	}

	@media (max-width: 760px) {
		.uses {
			columns: 1;
		}
	}
</style>
