---
/**
 * CursorField — a full-viewport WebGL2 ordered-dither field behind all content,
 * in the spirit of paper-design's dithered backgrounds: animated, domain-warped
 * fBm noise quantised through a Bayer dither into a fine grid of ink dots over a
 * transparent canvas (so the real paper shows through), disturbed locally by the
 * pointer. Decorative only — hidden from assistive tech, static under
 * `prefers-reduced-motion`, paused while the tab is hidden, persisted across
 * navigations, and its dot colour read from the Rams tokens so it follows theme.
 */
---

<canvas id="cursor-field" aria-hidden="true" transition:persist="cursor-field"></canvas>

<style>
	#cursor-field {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	@media print {
		#cursor-field {
			display: none;
		}
	}
</style>

<script>
	type Rgb = [number, number, number];

	function hexToRgb(hex: string, fallback: Rgb): Rgb {
		const clean = hex.replace("#", "").trim();
		const value = clean.length === 3 ? clean.replace(/(.)/g, "$1$1") : clean;
		if (value.length < 6) return fallback;
		const r = Number.parseInt(value.slice(0, 2), 16);
		const g = Number.parseInt(value.slice(2, 4), 16);
		const b = Number.parseInt(value.slice(4, 6), 16);
		if (Number.isNaN(r) || Number.isNaN(g) || Number.isNaN(b)) return fallback;
		return [r / 255, g / 255, b / 255];
	}

	function readPalette(): { ink: Rgb; accent: Rgb } {
		const style = getComputedStyle(document.documentElement);
		return {
			ink: hexToRgb(style.getPropertyValue("--ink").trim(), [0.11, 0.1, 0.09]),
			accent: hexToRgb(style.getPropertyValue("--accent").trim(), [0.86, 0.29, 0.07]),
		};
	}

	const VERT = `#version 300 es
in vec2 a_position;
void main() { gl_Position = vec4(a_position, 0.0, 1.0); }`;

	const FRAG = `#version 300 es
precision highp float;
out vec4 fragColor;
uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform vec3 u_ink;
uniform vec3 u_accent;
uniform float u_cell;
uniform float u_strength;
float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
float noise(vec2 p){
	vec2 i = floor(p), f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
	           mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
float fbm(vec2 p){
	float a = 0.5, s = 0.0;
	for (int i = 0; i < 5; i++){ s += a * noise(p); p = p * 2.02 + 7.0; a *= 0.5; }
	return s;
}
const float bayer[16] = float[16](
	0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0,
	3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0
);
float ordered(vec2 cell){
	int x = int(mod(cell.x, 4.0));
	int y = int(mod(cell.y, 4.0));
	return (bayer[y * 4 + x] + 0.5) / 16.0;
}
void main(){
	vec2 frag = gl_FragCoord.xy;
	vec2 uv = frag / u_resolution;
	float aspect = u_resolution.x / u_resolution.y;
	vec2 p = vec2(uv.x * aspect, uv.y);
	float t = u_time * 0.05;
	vec2 warp = vec2(fbm(p * 2.0 + t), fbm(p * 2.0 - t + 5.0));
	float n = fbm(p * 3.0 + warp * 0.6 + vec2(t, -t));
	float v = smoothstep(0.32, 0.72, n);
	vec2 m = vec2(u_mouse.x * aspect, u_mouse.y);
	float near = smoothstep(0.35, 0.0, distance(p, m));
	v += near * 0.35;
	vec2 cell = floor(frag / u_cell);
	vec2 local = (frag - (cell + 0.5) * u_cell) / u_cell;
	float thr = ordered(cell);
	float on = smoothstep(thr - 0.08, thr + 0.08, v);
	float d = length(local) * 2.0;
	float aa = fwidth(d) + 0.02;
	float disk = 1.0 - smoothstep(0.72 - aa, 0.72 + aa, d);
	vec3 color = mix(u_ink, u_accent, near * 0.5);
	fragColor = vec4(color, on * disk * u_strength);
}`;

	function initCursorField(): void {
		const element = document.getElementById("cursor-field");
		if (!(element instanceof HTMLCanvasElement)) return;
		if (element.dataset.ready === "true") return;
		element.dataset.ready = "true";

		const context = element.getContext("webgl2", {
			alpha: true,
			premultipliedAlpha: false,
			// Keep the last frame so the static (reduced-motion) render persists.
			preserveDrawingBuffer: true,
		});
		if (!context) return;
		// Bind the narrowed, non-null handles so the closures keep the types.
		const gl = context;
		const canvas = element;

		function build(ctx: WebGL2RenderingContext): WebGLProgram | null {
			const compile = (type: number, src: string): WebGLShader | null => {
				const shader = ctx.createShader(type);
				if (!shader) return null;
				ctx.shaderSource(shader, src);
				ctx.compileShader(shader);
				return ctx.getShaderParameter(shader, ctx.COMPILE_STATUS) ? shader : null;
			};
			const vs = compile(ctx.VERTEX_SHADER, VERT);
			const fs = compile(ctx.FRAGMENT_SHADER, FRAG);
			if (!vs || !fs) return null;
			const created = ctx.createProgram();
			if (!created) return null;
			ctx.attachShader(created, vs);
			ctx.attachShader(created, fs);
			ctx.linkProgram(created);
			return ctx.getProgramParameter(created, ctx.LINK_STATUS) ? created : null;
		}

		const program = build(gl);
		if (!program) return;
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(
			gl.ARRAY_BUFFER,
			new Float32Array([-1, -1, 3, -1, -1, 3]),
			gl.STATIC_DRAW,
		);
		const position = gl.getAttribLocation(program, "a_position");
		gl.enableVertexAttribArray(position);
		gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

		const uniform = (name: string) => gl.getUniformLocation(program, name);
		const uResolution = uniform("u_resolution");
		const uTime = uniform("u_time");
		const uMouse = uniform("u_mouse");
		const uInk = uniform("u_ink");
		const uAccent = uniform("u_accent");
		const uCell = uniform("u_cell");
		const uStrength = uniform("u_strength");

		gl.enable(gl.BLEND);
		gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let palette = readPalette();
		let width = 0;
		let height = 0;
		let dpr = 1;
		let mouseX = 0.5;
		let mouseY = 0.5;
		let raf = 0;
		const started = performance.now();

		function resize(): void {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = window.innerWidth;
			height = window.innerHeight;
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			gl.viewport(0, 0, canvas.width, canvas.height);
		}

		function render(now: number): void {
			gl.uniform2f(uResolution, canvas.width, canvas.height);
			gl.uniform1f(uTime, (now - started) / 1000);
			gl.uniform2f(uMouse, mouseX, mouseY);
			gl.uniform3f(uInk, palette.ink[0], palette.ink[1], palette.ink[2]);
			gl.uniform3f(uAccent, palette.accent[0], palette.accent[1], palette.accent[2]);
			gl.uniform1f(uCell, 5 * dpr);
			gl.uniform1f(uStrength, 0.55);
			gl.clearColor(0, 0, 0, 0);
			gl.clear(gl.COLOR_BUFFER_BIT);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		}

		function frame(now: number): void {
			render(now);
			raf = window.requestAnimationFrame(frame);
		}

		function start(): void {
			if (raf || reduceMotion.matches || document.hidden) return;
			raf = window.requestAnimationFrame(frame);
		}

		function stop(): void {
			if (raf) window.cancelAnimationFrame(raf);
			raf = 0;
		}

		resize();
		render(started);
		window.addEventListener(
			"pointermove",
			(event: PointerEvent) => {
				mouseX = event.clientX / width;
				mouseY = 1 - event.clientY / height;
			},
			{ passive: true },
		);
		window.addEventListener("resize", () => {
			resize();
			if (reduceMotion.matches || document.hidden) render(performance.now());
		});
		reduceMotion.addEventListener("change", () => {
			if (reduceMotion.matches) {
				stop();
				render(performance.now());
			} else {
				start();
			}
		});
		window
			.matchMedia("(prefers-color-scheme: dark)")
			.addEventListener("change", () => {
				palette = readPalette();
				if (reduceMotion.matches || document.hidden) render(performance.now());
			});
		document.addEventListener("astro:after-swap", () => {
			palette = readPalette();
		});
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) stop();
			else start();
		});

		if (!reduceMotion.matches) start();
	}

	initCursorField();
	document.addEventListener("astro:page-load", initCursorField);
</script>
