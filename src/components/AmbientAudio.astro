---
/**
 * AmbientAudio — a small Easter-egg button (top-right) that toggles a calm,
 * generative Web Audio soundscape: a slowly evolving pad plus occasional soft
 * pentatonic notes. Nothing is pre-recorded. The engine is a session singleton
 * on `window` and the button is persisted across ClientRouter navigations, so
 * the sound keeps playing as you move around the site.
 */
---

<button
	id="ambient-toggle"
	type="button"
	class="ambient"
	aria-pressed="false"
	aria-label="Play ambient sound"
	title="Ambient sound"
	transition:persist="ambient-audio"
>
	<span class="ambient__icons" aria-hidden="true">
		<svg class="ambient__icon ambient__icon--muted" viewBox="0 0 24 24">
			<path d="M11 5 6 9H3v6h3l5 4z" />
			<path d="m16 9 5 6" />
			<path d="m21 9-5 6" />
		</svg>
		<svg class="ambient__icon ambient__icon--on" viewBox="0 0 24 24">
			<path d="M11 5 6 9H3v6h3l5 4z" />
			<path class="ambient__wave" d="M15.5 8.5a5 5 0 0 1 0 7" />
			<path class="ambient__wave" d="M18 6a9 9 0 0 1 0 12" />
		</svg>
	</span>
</button>

<style>
	.ambient {
		position: fixed;
		top: 18px;
		right: 18px;
		z-index: 50;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		color: var(--text-meta);
		background: color-mix(in srgb, var(--surface-card) 72%, transparent);
		border: var(--border-hairline-w) solid var(--border-hairline);
		border-radius: var(--radius);
		cursor: pointer;
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		transition:
			color var(--dur) var(--ease),
			background-color var(--dur) var(--ease),
			border-color var(--dur) var(--ease),
			transform var(--dur) var(--ease);
	}

	.ambient:hover {
		color: var(--text-heading);
		border-color: var(--border-strong);
	}

	.ambient:active {
		transform: scale(0.96);
	}

	.ambient:focus-visible {
		outline: var(--border-strong-w) solid var(--accent);
		outline-offset: 2px;
	}

	.ambient[aria-pressed="true"] {
		color: var(--accent);
		border-color: var(--accent);
		background: var(--accent-tint);
	}

	.ambient__icons {
		position: relative;
		width: 18px;
		height: 18px;
	}

	.ambient__icon {
		position: absolute;
		inset: 0;
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity var(--dur-move) var(--ease),
			transform var(--dur-move) var(--ease),
			filter var(--dur-move) var(--ease);
	}

	/* Icon cross-fade — scale 0.25→1, opacity 0→1, blur 4px→0 on the firm ease. */
	.ambient__icon--on {
		opacity: 0;
		transform: scale(0.25);
		filter: blur(4px);
	}

	.ambient[aria-pressed="true"] .ambient__icon--muted {
		opacity: 0;
		transform: scale(0.25);
		filter: blur(4px);
	}

	.ambient[aria-pressed="true"] .ambient__icon--on {
		opacity: 1;
		transform: scale(1);
		filter: blur(0);
	}

	/* The sound waves breathe only while playing, and only if motion is welcome. */
	@media (prefers-reduced-motion: no-preference) {
		.ambient[aria-pressed="true"] .ambient__wave {
			animation: ambient-wave 1.9s var(--ease) infinite;
		}

		.ambient__wave:last-of-type {
			animation-delay: 0.2s;
		}
	}

	@keyframes ambient-wave {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}
</style>

<script>
	type AmbientEngine = {
		toggle: () => Promise<boolean>;
		isPlaying: () => boolean;
		subscribe: (listener: (playing: boolean) => void) => void;
	};

	function createEngine(): AmbientEngine {
		const AudioCtor =
			window.AudioContext ??
			(window as unknown as { webkitAudioContext?: typeof AudioContext })
				.webkitAudioContext;

		type Chord = { bass: number; triad: [number, number, number] };

		const listeners = new Set<(playing: boolean) => void>();
		let ctx: AudioContext | null = null;
		let master: GainNode | null = null;
		let delay: DelayNode | null = null;
		let padVoices: OscillatorNode[] = [];
		let playing = false;
		let schedulerTimer = 0;
		let step = 0;
		let nextStepTime = 0;
		let melodyIndex = 3;

		// I–V–vi–IV in C major — a warm, resolved four-bar loop.
		const progression: Chord[] = [
			{ bass: 65.41, triad: [130.81, 164.81, 196.0] },
			{ bass: 98.0, triad: [196.0, 246.94, 293.66] },
			{ bass: 110.0, triad: [220.0, 261.63, 329.63] },
			{ bass: 87.31, triad: [174.61, 220.0, 261.63] },
		];
		// C-major pentatonic — consonant over every chord above, so no wrong notes.
		const scale = [261.63, 293.66, 329.63, 392.0, 440.0, 523.25, 587.33, 659.25];
		const walk = [-2, -1, -1, 0, 1, 1, 2];

		const beat = 60 / 72; // ~72 BPM
		const stepDur = beat / 2; // eighth notes
		const stepsPerBar = 8;

		function emit(): void {
			for (const listener of listeners) listener(playing);
		}

		function build(context: AudioContext): void {
			const bus = context.createGain();
			bus.gain.value = 0;
			const comp = context.createDynamicsCompressor();
			bus.connect(comp);
			comp.connect(context.destination);
			master = bus;

			// Shared space for the lead and bass.
			const echo = context.createDelay(1);
			echo.delayTime.value = 0.36;
			const feedback = context.createGain();
			feedback.gain.value = 0.3;
			echo.connect(feedback);
			feedback.connect(echo);
			echo.connect(bus);
			delay = echo;

			// Sustained chord pad through a warm low-pass; it glides between chords.
			const filter = context.createBiquadFilter();
			filter.type = "lowpass";
			filter.frequency.value = 1200;
			filter.Q.value = 2;
			const padGain = context.createGain();
			padGain.gain.value = 0.16;
			filter.connect(padGain);
			padGain.connect(bus);

			const opening = progression[0];
			const triad = opening ? opening.triad : [130.81, 164.81, 196.0];
			padVoices = triad.map((frequency, index) => {
				const osc = context.createOscillator();
				osc.type = index === 0 ? "sine" : "triangle";
				osc.frequency.value = frequency;
				osc.detune.value = (index - 1) * 4;
				const voiceGain = context.createGain();
				voiceGain.gain.value = index === 0 ? 0.5 : 0.34;
				osc.connect(voiceGain);
				voiceGain.connect(filter);
				osc.start();
				return osc;
			});

			// A slow breath so held chords never sit perfectly still.
			const breathLfo = context.createOscillator();
			breathLfo.type = "sine";
			breathLfo.frequency.value = 0.07;
			const breathDepth = context.createGain();
			breathDepth.gain.value = 0.05;
			breathLfo.connect(breathDepth);
			breathDepth.connect(padGain.gain);
			breathLfo.start();
		}

		/** One plucked voice with a soft attack and an exponential tail. */
		function pluck(
			frequency: number,
			time: number,
			type: OscillatorType,
			peak: number,
			release: number,
			wet: boolean,
		): void {
			if (!ctx || !master) return;
			const osc = ctx.createOscillator();
			osc.type = type;
			osc.frequency.value = frequency;
			const gain = ctx.createGain();
			gain.gain.setValueAtTime(0.0001, time);
			gain.gain.linearRampToValueAtTime(peak, time + 0.012);
			gain.gain.exponentialRampToValueAtTime(0.0001, time + release);
			osc.connect(gain);
			gain.connect(master);
			if (wet && delay) gain.connect(delay);
			osc.start(time);
			osc.stop(time + release + 0.05);
		}

		function scheduleStep(index: number, time: number): void {
			const bar = Math.floor(index / stepsPerBar) % progression.length;
			const chord = progression[bar];
			if (!chord) return;
			const inBar = index % stepsPerBar;

			if (inBar === 0) {
				// Glide the pad to the new chord and land the bass root.
				padVoices.forEach((osc, i) => {
					const target = chord.triad[i];
					if (target !== undefined) {
						osc.frequency.setTargetAtTime(target, time, 0.25);
					}
				});
				pluck(chord.bass, time, "sine", 0.13, 2.2, false);
			} else if (inBar === 4) {
				// A soft octave pulse mid-bar keeps a gentle sense of time.
				pluck(chord.bass * 2, time, "sine", 0.06, 1.4, false);
			}

			// Melody: a pentatonic random walk with rests, so it phrases.
			if (Math.random() < 0.62) {
				const delta = walk[Math.floor(Math.random() * walk.length)] ?? 0;
				melodyIndex = Math.min(Math.max(melodyIndex + delta, 0), scale.length - 1);
				const note = scale[melodyIndex];
				if (note !== undefined) pluck(note, time, "triangle", 0.1, 1.5, true);
			}
		}

		function runScheduler(): void {
			if (!ctx) return;
			// Schedule everything a little ahead so timing stays tight.
			while (nextStepTime < ctx.currentTime + 0.12) {
				scheduleStep(step, nextStepTime);
				nextStepTime += stepDur;
				step += 1;
			}
			schedulerTimer = window.setTimeout(runScheduler, 25);
		}

		async function start(): Promise<boolean> {
			if (playing) return true;
			if (!AudioCtor) return false;
			if (!ctx) {
				ctx = new AudioCtor();
				build(ctx);
			}
			await ctx.resume();
			if (!master) return false;
			playing = true;
			const now = ctx.currentTime;
			master.gain.cancelScheduledValues(now);
			master.gain.setValueAtTime(master.gain.value, now);
			master.gain.linearRampToValueAtTime(0.8, now + 1.6);
			nextStepTime = now + 0.15;
			runScheduler();
			emit();
			return true;
		}

		function stop(): boolean {
			if (!playing || !ctx || !master) return false;
			playing = false;
			window.clearTimeout(schedulerTimer);
			const now = ctx.currentTime;
			master.gain.cancelScheduledValues(now);
			master.gain.setValueAtTime(master.gain.value, now);
			master.gain.linearRampToValueAtTime(0, now + 0.6);
			emit();
			return false;
		}

		return {
			toggle: () => (playing ? Promise.resolve(stop()) : start()),
			isPlaying: () => playing,
			subscribe: (listener) => {
				listeners.add(listener);
			},
		};
	}

	function getEngine(): AmbientEngine {
		const store = window as unknown as { __ambientEngine?: AmbientEngine };
		if (!store.__ambientEngine) store.__ambientEngine = createEngine();
		return store.__ambientEngine;
	}

	function initAmbientToggle(): void {
		const button = document.getElementById("ambient-toggle");
		if (!(button instanceof HTMLButtonElement)) return;
		// Persisted across navigations; wire the click and subscription once.
		if (button.dataset.ready === "true") return;
		button.dataset.ready = "true";

		const engine = getEngine();
		const sync = (playing: boolean): void => {
			button.setAttribute("aria-pressed", String(playing));
			button.setAttribute(
				"aria-label",
				playing ? "Stop ambient sound" : "Play ambient sound",
			);
		};
		engine.subscribe(sync);
		sync(engine.isPlaying());
		button.addEventListener("click", () => {
			void engine.toggle();
		});
	}

	initAmbientToggle();
	document.addEventListener("astro:page-load", initAmbientToggle);
</script>
