---
import BaseHead from "../components/BaseHead.astro";
import type { Post } from "../models";
import AmbientAudio from "./AmbientAudio.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

type Props = {
	title?: string | undefined;
	description?: string | undefined;
	post?: Post | undefined;
};

const { title, description, post } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} post={post} />
    <slot name="head" />
  </head>

  <body>
    <AmbientAudio />

    <div class="shell">
      <SiteHeader />

      <main>
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>

<style>
	/* One centred column; the masthead and colophon share its edges. */
	.shell {
		max-width: var(--page-max);
		min-height: 100vh;
		margin: 0 auto;
		padding: 0 var(--page-pad) 90px;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		min-width: 0;
	}

	@media (max-width: 900px) {
		.shell {
			padding: 0 var(--page-pad-narrow) 64px;
		}
	}
</style>
