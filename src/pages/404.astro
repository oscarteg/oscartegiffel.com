---

import Body from "../components/Body.astro";
import PageIntro from "../components/PageIntro.astro";
---

<Body title="404" description="Are you sure you are in the right place?">
  <PageIntro eyebrow="404" title="Nothing here">
    <p class="four-oh-four">
      That page doesn't exist — or it moved. Nothing here is lost for long.
    </p>
    <a href="/" class="label label--tight label--ink four-oh-four__back">← Back home</a>
  </PageIntro>
</Body>

<style>
	.four-oh-four {
		font: var(--type-small);
		color: var(--text-muted);
		max-width: 52ch;
		margin: 0 0 32px;
	}

	.four-oh-four__back:hover {
		color: var(--text-meta);
	}
</style>
