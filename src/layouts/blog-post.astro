---

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import DraftMarker from "../components/DraftMarker.astro";
import type { Post } from "../models";
import { filterPosts, postVisibility } from "../utils";
import DefaultLayout from "./default.astro";

type Props = {
	post: Post;
	lastModified: Date;
	headings?: { depth: number; slug: string; text: string }[];
};

const { post } = Astro.props;

const {
	title,
	description = "",
	cover,
	publishDate,
	resources = [],
	showResources = true,
	series,
} = post.data;

const visibleResources = showResources ? resources : [];

const seriesPosts = series
	? (await getCollection("blog", filterPosts))
			.filter((entry) => entry.data.series === series)
			.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
	: [];

const currentPart = seriesPosts.findIndex((entry) => entry.id === post.id) + 1;

const visibility = postVisibility(post);
const kind = series ? "Series" : "Essay";
---

<DefaultLayout title={title} description={description} post={post} frontmatter={{ title, description }}>
  <header slot="intro" class="post__head">
    <a href="/blog" class="label label--tight post__back">← Writing</a>
    <p class="label label--tight post__meta">
      {publishDate && <span>{dayjs(publishDate).format("DD MMM YYYY")} · {kind}</span>}
      <DraftMarker visibility={visibility} />
    </p>
    <h1 class="post__title">{title}<span class="stop">.</span></h1>
    {description && <p class="post__description">{description}</p>}
  </header>

  {
    seriesPosts.length > 0 && (
      <nav class="not-prose series">
        <p class="label label--accent series__label">
          {series} · Part {currentPart} of {seriesPosts.length}
        </p>
        <ol class="series__list">
          {seriesPosts.map((entry, index) => (
            <li>
              <span class="series__index">{String(index + 1).padStart(2, "0")}</span>
              {entry.id === post.id ? (
                <span class="series__current">{entry.data.title}</span>
              ) : (
                <a href={`/blog/${entry.id}`}>{entry.data.title}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  {
    cover && (
      <div class="not-prose post__cover">
        <Image src={cover} alt="cover" />
      </div>
    )
  }

  <slot />

  {
    visibleResources.length > 0 && (
      <section class="not-prose resources">
        <p class="label resources__label">Resources</p>
        <ul>
          {visibleResources.map((resource) => (
            <li>
              <a href={resource.url} target="_blank" rel="noopener noreferrer">
                {resource.title ?? new URL(resource.url).hostname.replace(/^www\./, "")}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <aside class="not-prose colophon">
    <p class="label label--accent colophon__label">How it was written</p>
    <p class="colophon__body">
      Most of the content was written by my own hand, but I did leverage AI for
      many things, such as polishing, structuring, research and review.
    </p>
  </aside>
</DefaultLayout>

<style>
	.post__head {
		max-width: var(--reading-max);
		padding: 80px 0 48px;
	}

	.post__back:hover {
		color: var(--text-heading);
	}

	.post__meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin: 36px 0 14px;
	}

	.post__title {
		font: var(--type-h2);
		font-size: clamp(36px, 4vw, 52px);
		letter-spacing: var(--track-display);
		color: var(--text-heading);
		margin: 0 0 16px;
	}

	.post__description {
		font: var(--type-lead);
		color: var(--text-body);
		margin: 0;
	}

	/* --- series --- */
	.series {
		width: 100%;
		border-top: var(--border-hairline-w) solid var(--border-hairline);
		padding-top: 18px;
		margin-bottom: 40px;
	}

	.series__label {
		margin: 0 0 12px;
	}

	.series__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.series__list li {
		display: flex;
		align-items: baseline;
		gap: 12px;
		font: var(--type-small);
	}

	.series__index {
		font: var(--type-label-sm);
		letter-spacing: var(--track-label-tight);
		color: var(--text-meta);
		flex-shrink: 0;
	}

	.series__current {
		font-weight: var(--weight-medium);
		color: var(--text-heading);
	}

	.series__list a {
		color: var(--text-muted);
	}

	.series__list a:hover {
		color: var(--text-heading);
	}

	/* Images sit in hairline frames; never full-bleed, never rounded. */
	.post__cover {
		border: var(--border-hairline-w) solid var(--border-soft);
		margin-bottom: 32px;
	}

	.post__cover :global(img) {
		display: block;
		width: 100%;
		height: 12rem;
		object-fit: cover;
	}

	/* --- resources + colophon: ruled asides --- */
	.resources,
	.colophon {
		width: 100%;
		border-top: var(--border-hairline-w) solid var(--border-hairline);
		padding-top: 18px;
	}

	.resources {
		margin-top: 44px;
	}

	.colophon {
		margin-top: 32px;
	}

	.resources__label,
	.colophon__label {
		font: var(--type-label-sm);
		letter-spacing: var(--track-label);
		margin: 0 0 8px;
	}

	.colophon__body {
		font: var(--type-small);
		color: var(--text-muted);
		margin: 0;
	}

	.resources ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.resources a {
		font: var(--type-small);
		color: var(--text-muted);
		word-break: break-word;
	}

	.resources a:hover {
		color: var(--text-heading);
	}

	@media (max-width: 640px) {
		.post__head {
			padding: 40px 0 32px;
		}
	}
</style>
