---

import Body from "../components/Body.astro";
import PageIntro from "../components/PageIntro.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import type { Post } from "../models";

/**
 * The reading layout: a title page, then a prose column. Markdown pages
 * (uses, taste) pick it through `layout:` in their frontmatter; the blog
 * post layout wraps it with its own head.
 */
type Props = {
	title?: string;
	description?: string;
	prose?: boolean;
	post?: Post;
	frontmatter?: {
		title?: string;
		description?: string;
		/** Uppercase eyebrow above the title. Defaults to the title. */
		eyebrow?: string;
		/** Edition date, appended to the eyebrow on a versioned page. */
		edition?: string;
		/** Widens the prose column to the full page. */
		wide?: boolean;
		markdownUrl?: string;
		/** Pins each `##` group label while its section scrolls past. */
		stickyGroups?: boolean;
	};
};

const {
	prose = true,
	frontmatter,
	title: propsTitle,
	description: propsDescription,
	post,
} = Astro.props;

const title = propsTitle || frontmatter?.title || SITE_TITLE;
const description =
	propsDescription || frontmatter?.description || SITE_DESCRIPTION;
const markdownUrl = frontmatter?.markdownUrl;
const edition = frontmatter?.edition;
const eyebrowBase = frontmatter?.eyebrow ?? title;
const eyebrow = edition ? `${eyebrowBase} · Edition ${edition}` : eyebrowBase;
---

<Body title={title} description={description} post={post}>
  {markdownUrl && <Fragment slot="head"><link rel="alternate" type="text/markdown" href={new URL(markdownUrl, Astro.site).href} /></Fragment>}

  {
    Astro.slots.has("intro") ? (
      <slot name="intro" />
    ) : (
      <PageIntro eyebrow={eyebrow} title={title} compact>
        {markdownUrl && (
          <a class="label label--tight reading__md" href={markdownUrl} target="_blank" rel="noopener noreferrer">
            View as .md ↗
          </a>
        )}
      </PageIntro>
    )
  }

  <div class:list={["reading", frontmatter?.wide && "reading--wide", prose && "prose", frontmatter?.stickyGroups && "prose--sticky-groups"]}>
    <slot />
  </div>
</Body>

<style>
	.reading {
		width: 100%;
		max-width: var(--reading-max);
	}

	.reading--wide {
		max-width: none;
	}

	.reading__md {
		display: inline-block;
	}

	.reading__md:hover {
		color: var(--text-heading);
	}
</style>
