---
import Body from "../components/Body.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";

type Props = {
	title?: string;
	description?: string;
	headings?: { depth: number; slug: string; text: string }[];
	frontmatter?: {
		title?: string;
		description?: string;
		/** Printed above the title on the title page. */
		subtitle?: string;
		/** Stamped under the title. */
		edition?: string;
		toc?: boolean;
		markdownUrl?: string;
	};
};

const {
	frontmatter,
	headings = [],
	title: propsTitle,
	description: propsDescription,
} = Astro.props;

const title = propsTitle || frontmatter?.title || SITE_TITLE;
const description =
	propsDescription || frontmatter?.description || SITE_DESCRIPTION;
const toc = frontmatter?.toc === true;
const markdownUrl = frontmatter?.markdownUrl;
const subtitle = frontmatter?.subtitle;
const edition = frontmatter?.edition;
---

<Body title={title} description={description} headings={headings} toc={toc}>
  {markdownUrl && <Fragment slot="head"><link rel="alternate" type="text/markdown" href={new URL(markdownUrl, Astro.site).href} /></Fragment>}

  <div class="book">
    <article class="book__body">
      <header class="book__cover">
        {subtitle && <p class="book__subtitle">{subtitle}</p>}
        <h1 class="book__title">{title}</h1>
        {description && <p class="book__blurb">{description}</p>}
        {edition && <p class="book__edition">First edition · {edition}</p>}
        {
          markdownUrl && (
            <a class="book__md" href={markdownUrl} target="_blank" rel="noopener noreferrer">
              View as .md ↗
            </a>
          )
        }
      </header>

      <slot />
    </article>
  </div>
</Body>

<style>
	/* A sheet on the desk. The dither field is fixed behind everything and the
	   body paints no background box of its own, so this fill is the only thing
	   keeping the texture out of the prose. */
	.book {
		background: var(--surface-page);
		border: var(--border-hairline-w) solid var(--border-hairline);
		color: var(--ink-soft);
		padding: 72px;
		max-width: 100%;
	}

	.book__body {
		font: var(--text-book);
		font-family: var(--font-serif);
		font-feature-settings:
			"kern" 1,
			"liga" 1,
			"onum" 1;
	}

	/* ---------- title page ---------- */

	.book__cover {
		text-align: center;
		padding: 24px 0 64px;
		border-bottom: var(--border-hairline-w) solid var(--border-hairline);
		margin-bottom: 72px;
	}

	.book__subtitle {
		font: var(--text-kicker);
		font-family: var(--font-mono);
		letter-spacing: var(--track-kicker);
		text-transform: uppercase;
		color: var(--text-meta);
		margin: 0 0 28px;
	}

	.book__title {
		font-family: var(--font-serif);
		font-size: 52px;
		font-weight: var(--weight-regular);
		line-height: 1.05;
		letter-spacing: var(--track-tight);
		color: var(--text-heading);
		text-wrap: balance;
		margin: 0;
	}

	.book__blurb {
		font-family: var(--font-serif);
		font-size: 21px;
		font-style: italic;
		line-height: 1.5;
		color: var(--text-muted);
		text-wrap: pretty;
		max-width: 46ch;
		margin: 24px auto 0;
	}

	.book__edition {
		font: var(--text-mono-sm);
		letter-spacing: var(--track-kicker);
		text-transform: uppercase;
		color: var(--text-meta);
		margin: 40px 0 0;
	}

	.book__md {
		display: inline-block;
		font: var(--text-mono-sm);
		color: var(--link);
		text-decoration: none;
		margin-top: 12px;
	}

	.book__md:hover {
		color: var(--link-hover);
	}

	/* These belong with the rules they override: Astro scopes everything in
	   this block to the component, which outranks the plain selectors in the
	   global block below. */
	@media (max-width: 1180px) {
		.book {
			padding: 56px 48px;
		}
	}

	@media (max-width: 900px) {
		.book {
			padding: 40px 24px;
			border-left: 0;
			border-right: 0;
		}

		.book__cover {
			padding: 8px 0 48px;
			margin-bottom: 56px;
		}

		.book__title {
			font-size: 38px;
		}

		.book__blurb {
			font-size: 19px;
		}
	}
</style>

<style is:global>
	/* The book carries its own type system rather than the `.prose` retuning:
	   the typography plugin's scale is built for a grotesk document and fights
	   a serif at every heading. */
	.book {
		--text-book: var(--weight-regular) 19px / 1.72 var(--font-serif);
		--book-measure: 66ch;
		--book-hang: 3.5rem;
	}

	.book__body > p {
		font: var(--text-book);
		max-width: var(--book-measure);
		color: var(--ink-soft);
		text-wrap: pretty;
		margin: 0 0 1.35em;
	}

	.book__body a {
		color: var(--link);
		text-underline-offset: 0.18em;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--border-hairline);
	}

	.book__body a:hover {
		color: var(--link-hover);
		text-decoration-color: currentColor;
	}

	.book__body strong {
		font-weight: var(--weight-bold);
		color: var(--text-heading);
	}

	.book__body code {
		font-family: var(--font-mono);
		font-size: 0.82em;
		background: var(--surface-card);
		border: var(--border-hairline-w) solid var(--border-hairline);
		border-radius: var(--radius-chip);
		padding: 0.1rem 0.35rem;
	}

	.book__body ul,
	.book__body ol {
		font: var(--text-book);
		max-width: var(--book-measure);
		margin: 0 0 1.35em;
		padding-left: 1.4em;
	}

	.book__body li {
		margin: 0 0 0.4em;
	}

	.book__body li::marker {
		color: var(--marker);
	}

	.book__body hr {
		border: 0;
		border-top: var(--border-hairline-w) solid var(--border-hairline);
		margin: 3em 0;
	}

	/* ---------- chapter openings ---------- */

	.book__body h2 {
		font-family: var(--font-serif);
		font-size: 34px;
		font-weight: var(--weight-regular);
		line-height: 1.15;
		letter-spacing: var(--track-heading);
		color: var(--text-heading);
		text-align: center;
		text-wrap: balance;
		border-bottom: var(--border-hairline-w) solid var(--border-hairline);
		padding-bottom: 32px;
		margin: 112px 0 56px;
	}

	.book__body h2:first-child {
		margin-top: 0;
	}

	.book__body h2 .chapter__label {
		display: block;
		font: var(--text-kicker);
		font-family: var(--font-mono);
		letter-spacing: var(--track-kicker);
		text-transform: uppercase;
		color: var(--text-meta);
		margin-bottom: 20px;
	}

	.book__body h2 .chapter__title {
		display: block;
	}

	/* ---------- verses ---------- */

	.book__body h3 {
		position: relative;
		font-family: var(--font-serif);
		font-size: 22px;
		font-weight: var(--weight-semibold);
		line-height: 1.3;
		letter-spacing: var(--track-heading);
		color: var(--text-heading);
		max-width: var(--book-measure);
		text-wrap: balance;
		margin: 2.4em 0 0.7em;
	}

	/* The verse number hangs in the margin the way scripture sets it, so the
	   titles keep a single flush left edge with the prose beneath them. */
	.book__body h3 .verse__num {
		position: absolute;
		left: calc(var(--book-hang) * -1);
		width: calc(var(--book-hang) - 0.9rem);
		text-align: right;
		font: var(--text-mono-sm);
		font-variant-numeric: tabular-nums;
		color: var(--text-meta);
		line-height: inherit;
		padding-top: 0.35em;
	}

	.book__body .chapter__sep,
	.book__body .verse__sep {
		display: none;
	}

	/* The hanging numbers need the gutter to hang into; below that they fold
	   back inline. */
	@media (max-width: 1180px) {
		.book__body h3 .verse__num {
			position: static;
			display: block;
			width: auto;
			text-align: left;
			padding-top: 0;
			margin-bottom: 6px;
		}
	}

	@media (max-width: 900px) {
		.book__body h2 {
			font-size: 27px;
			margin: 80px 0 40px;
		}

		.book__body h3 {
			font-size: 20px;
		}
	}
</style>
