{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",

	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/*.astro",
			"!.astro",
			"!.claude",
			"!.codegraph",
			"!.devbox",
			"!.jj",
			"!.omo",
			"!.vscode",
			"!devbox.json",
			"!dist",
			"!node_modules",
			"!public"
		]
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			"includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
