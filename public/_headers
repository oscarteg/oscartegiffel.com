/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/village-map/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://s3.amazonaws.com https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org https://s3.amazonaws.com https://tile.openstreetmap.org; frame-src https://www.youtube.com https://player.vimeo.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

