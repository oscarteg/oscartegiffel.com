		"@types/geojson": "^7946.0.16",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.1",
		"constructs": "10.8.1",
		"cypress": "^16.1.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "8.3.4",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.5.1"
