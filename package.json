{
	"name": "@oscartegiffel/homepage",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"preview": "astro preview",
		"astro": "astro",
		"build": "pnpm fetch-content && astro check && tsc --noEmit && astro build",
		"fetch-content": "tsx scripts/fetch-content.ts",
		"fetch-peaks": "tsx scripts/mountain-map/fetch-peaks.ts",
		"fetch-villages": "tsx scripts/village-map/fetch-villages.ts",
		"test": "vitest run",
		"format": "biome format --write src/",
		"lint": "biome lint --write src/",
		"check": "biome check --write src/",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/mdx": "8.0.3",
		"@astrojs/node": "^11.1.7",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/solid-js": "^7.0.2",
		"@astrojs/ts-plugin": "1.10.12",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "7.3.8",
		"autoprefixer": "^10.5.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.20",
		"katex": "^0.19.0",
		"maplibre-gl": "^6.13.0",
		"markdown-it": "^15.0.2",
		"octokit": "^5.0.5",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"remark-toc": "^9.0.0",
		"sanitize-html": "^2.17.4",
		"satori": "0.47.1",
		"sharp": "^0.35.3",
		"solid-js": "^1.9.13",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tiny-invariant": "^1.3.3",
		"valibot": "^1.5.0",
		"wretch": "^3.0.9",
		"zod": "^4.4.3"
